import java.util.ArrayList;
import java.util.Scanner;

class Complaint {

    int complaintId;
    String userName;
    String complaintType;
    String description;
    String status;

    Complaint(int id, String name, String type, String desc) {

        complaintId = id;
        userName = name;
        complaintType = type;
        description = desc;
        status = "Pending";
    }

    void display() {

        System.out.println("Complaint ID: " + complaintId);
        System.out.println("User Name: " + userName);
        System.out.println("Complaint Type: " + complaintType);
        System.out.println("Description: " + description);
        System.out.println("Status: " + status);
        System.out.println("----------------------");
    }
}


public class ComplaintManagementSystem {

    static ArrayList<Complaint> complaintList = new ArrayList<>();
    static Scanner sc = new Scanner(System.in);


    // Add Complaint
    static void addComplaint() {

        System.out.print("Enter Complaint ID: ");
        int id = sc.nextInt();

        sc.nextLine();

        System.out.print("Enter User Name: ");
        String name = sc.nextLine();

        System.out.print("Enter Complaint Type: ");
        String type = sc.nextLine();

        System.out.print("Enter Complaint Description: ");
        String desc = sc.nextLine();

        complaintList.add(new Complaint(id, name, type, desc));

        System.out.println("Complaint Added Successfully");
    }


    // View Complaint
    static void viewComplaint() {

        if(complaintList.size() == 0) {

            System.out.println("No Complaint Found");

        } else {

            for(Complaint c : complaintList) {
                c.display();
            }
        }
    }


    // Update Complaint Status
    static void updateComplaint() {

        System.out.print("Enter Complaint ID: ");
        int id = sc.nextInt();

        sc.nextLine();

        for(Complaint c : complaintList) {

            if(c.complaintId == id) {

                System.out.print("Enter New Status: ");
                c.status = sc.nextLine();

                System.out.println("Status Updated Successfully");
                return;
            }
        }

        System.out.println("Complaint Not Found");
    }


    // Delete Complaint
    static void deleteComplaint() {

        System.out.print("Enter Complaint ID: ");
        int id = sc.nextInt();


        for(Complaint c : complaintList) {

            if(c.complaintId == id) {

                complaintList.remove(c);

                System.out.println("Complaint Deleted Successfully");
                return;
            }
        }

        System.out.println("Complaint Not Found");
    }


    public static void main(String args[]) {

        int choice;

        do {

            System.out.println("\n===== Complaint Management System =====");
            System.out.println("1. Add Complaint");
            System.out.println("2. View Complaint");
            System.out.println("3. Update Status");
            System.out.println("4. Delete Complaint");
            System.out.println("5. Exit");

            System.out.print("Enter Choice: ");
            choice = sc.nextInt();


            switch(choice) {

                case 1:
                    addComplaint();
                    break;

                case 2:
                    viewComplaint();
                    break;

                case 3:
                    updateComplaint();
                    break;

                case 4:
                    deleteComplaint();
                    break;

                case 5:
                    System.out.println("Exit Successfully");
                    break;

                default:
                    System.out.println("Invalid Choice");
            }

        } while(choice != 5);
    }
}
